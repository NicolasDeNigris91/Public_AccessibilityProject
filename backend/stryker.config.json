{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing on the pure domain layer. Score gate is a no-regression baseline; lift toward 85% as more domain logic is exercised by tests.",
  "packageManager": "npm",
  "reporters": ["clear-text", "progress", "html"],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "mutate": ["src/domain/scoring.ts", "src/domain/urlSafety.ts", "src/domain/axeResult.ts"],
  "thresholds": { "high": 85, "low": 70, "break": 70 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
